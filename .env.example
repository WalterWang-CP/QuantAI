# Copy to .env only for a new installation; retain your existing .env.
# Create the PostgreSQL database before running Alembic.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/quantai
APP_NAME="QuantAI Data Engine"

# Optional for setup and tests; required for live Alpha Vantage requests.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BATCH_DAILY_BUDGET=20
ALPHA_VANTAGE_COMPACT_POINTS=100
ALPHA_VANTAGE_FULL_HISTORY_ENABLED=false

RETRIEVAL_MAX_ATTEMPTS=3
RETRIEVAL_RETRY_BASE_SECONDS=60
RETRIEVAL_DEFAULT_BATCH_LIMIT=5
RETRIEVAL_STALE_RUNNING_MINUTES=10

# SEC public API access: use your own real contact email, not this example.
SEC_USER_AGENT="QuantAI Walter your-real-email@example.com"
SEC_REQUEST_INTERVAL_SECONDS=0.5
SEC_TIMEOUT_SECONDS=30
SEC_MAX_ATTEMPTS=3
SEC_CACHE_TTL_SECONDS=300
SEC_MAX_HISTORY_FILES=20
